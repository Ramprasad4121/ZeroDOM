{
  "name": "zerodome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZeroDOM: scoped autonomous payments for browser agents, with x402 and sandbox virtual-card demos.",
  "bin": {
    "zerodome": "./bin/zerodome.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node scripts/run-demo.js",
    "demo:headless": "HEADLESS=1 node scripts/run-demo.js",
    "self-test": "node scripts/self-test.js",
    "test-server": "node scripts/test-server.js",
    "card-demo": "node --import tsx scripts/card-sandbox-demo.ts",
    "stripe-sandbox-smoke": "node --import tsx scripts/stripe-sandbox-smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "playwright": "^1.46.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

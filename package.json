{
  "name": "zerodome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZeroDOM: agent-agnostic scoped autonomous payments with sandbox virtual-card infrastructure.",
  "bin": {
    "zerodome": "./bin/zerodome.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node scripts/run-demo.js",
    "demo:headless": "HEADLESS=1 node scripts/run-demo.js",
    "self-test": "node scripts/self-test.js",
    "start-server": "node --import tsx scripts/start-server.ts",
    "server": "node --import tsx scripts/start-server.ts",
    "test-server": "node scripts/test-server.js",
    "card-demo": "node --import tsx scripts/card-sandbox-demo.ts",
    "checkout-harness": "node --import tsx scripts/playwright-checkout-harness.ts",
    "audit-demo": "node --import tsx scripts/audit-log-demo.ts",
    "integration-demo": "node --import tsx scripts/integration-demo.ts",
    "integration-server": "node --import tsx scripts/integration-server.ts",
    "mcp-server": "node --import tsx scripts/mcp-server.ts",
    "stripe-sandbox-smoke": "node --import tsx scripts/stripe-sandbox-smoke.ts",
    "readiness-check": "node --import tsx scripts/readiness-check.ts",
    "agent-demo": "node --import tsx scripts/autonomous-agent-demo.ts",
    "order-shoes": "node --import tsx scripts/order-shoes-demo.ts",
    "order-shoes-inr": "node --import tsx scripts/order-shoes-inr.ts",
    "cli-dashboard": "node --import tsx scripts/cli-dashboard.ts",
    "live-demo": "node --import tsx examples/live-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit false --outDir dist"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "playwright": "^1.46.1",
    "stripe": "^22.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
